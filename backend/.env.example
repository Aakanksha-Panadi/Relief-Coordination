# Copy to backend/.env and adjust.

# true  = canned extraction + explanations, no network calls (works offline /
#         on a locked-down corporate network)
# false = real Gemini via Vertex AI
MOCK_MODE=true

GOOGLE_CLOUD_PROJECT=resourceworkflow
VERTEX_LOCATION=us-central1
# gemini-2.0-flash is retired; it returns 404 on Vertex AI.
GEMINI_MODEL=gemini-2.5-flash
FIRESTORE_DATABASE=rescource-graph

# Path to the service account key, needed for Firestore + Vertex AI.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

PORT=8080
# Comma-separated frontend origins; * is fine for local dev.
CORS_ORIGINS=*
