# Copy to backend/.env and adjust.

# true  = canned extraction + explanations, no network calls (works offline /
#         on a locked-down corporate network)
# false = real Gemini via Vertex AI
MOCK_MODE=true

GOOGLE_CLOUD_PROJECT=resourceworkflow
VERTEX_LOCATION=us-central1
# gemini-2.0-flash is retired; it returns 404 on Vertex AI.
GEMINI_MODEL=gemini-2.5-flash
# Extraction must be repeatable: the same message should always produce the
# same urgency and people_count. Raise only if you want varied phrasing.
GEMINI_TEMPERATURE=0
FIRESTORE_DATABASE=rescource-graph

# Path to the service account key, needed for Firestore + Vertex AI.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

PORT=8080
# Comma-separated frontend origins; * is fine for local dev.
CORS_ORIGINS=*

# Gemini latency controls. thinking_budget 0 turns off gemini-2.5-flash's
# default deliberation, which dominated dispatch planning time.
GEMINI_THINKING_BUDGET=0
GEMINI_TIMEOUT_SECONDS=30

# Seconds of quiet before batched road changes trigger one replan.
# Keep this low for demos; raise it for a real control room.
REPLAN_DEBOUNCE_SECONDS=3

# Nothing can detect that a boat arrived, so a coordinator normally logs the
# check-in. With DEMO_CLOCK=true a timer files those check-ins instead, so a
# demo screen advances on its own. Every simulated event is marked as such,
# and the clock never approves anything.
DEMO_CLOCK=false
DEMO_CLOCK_SECONDS_PER_MINUTE=1
